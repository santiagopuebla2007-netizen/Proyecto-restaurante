body{
    background-color: #1e4624;
    color: #F1EBDD;
    font-family: 'Georgia', 'Times New Roman', Times, serif;
    margin: 0;
}

.header {
    display: flex;
    align-items: center;
    position: sticky;   
    top: 0;             
    z-index: 1000;     
    background-color: #1e4624; 
    padding: 15px 0;  
    width: 100%;
    gap: 60px;
}

h1{
   font-size: 48px;
    color: #F1EBDD;
    font-weight: normal;
    letter-spacing: 2px;
    margin: 40px auto 10px auto;
    text-align: center;
    font-family: Georgia, 'Times New Roman', Times, serif
}
main{
    margin-top: 100px; 
    margin-bottom: 150px;
}


.menu a{ 
    list-style: none;
    text-decoration: none;
    color: #F1EBDD;
    letter-spacing: 1px;
    font-size: 13px;
    font-weight: 500;
}

.menu ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 25px;
}

.logo img{
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
}

.subtitulo{
    font-size: 14px;
    color: #F1EBDD;
    opacity: 0.9;
    font-style: italic;
    text-align: center;
    
}

html{
   scroll-behavior: smooth;
}

.seccion-menu{
    margin-top: 400px;
    padding-top: 50px;  
    min-height: 80vh;
}


.seccion-menu {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    margin-top: 100px;
}

.texto-menu {
    max-width: 350px;
}

.fotos-menu {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.texto-menu a{
    color: #F1EBDD;
    text-decoration: none;
}

