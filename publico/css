body{
    background-color: #1e4624;
    color: #F1EBDD;
    font-family: 'Georgia', 'Times New Roman', Times, serif;
    margin: 0;
    width: 100%;
}

.header {
    display: flex;
    align-items: center;
    position: sticky;   
    top: 0;             
    z-index: 1000;     
    background-color: #edd7c5; 
    padding: 15px 0;  
    width: 100%;
    gap: 60px;
    box-shadow:0px 4px 6px rgb(5,5,5);
    justify-content: center;
     min-height: 80px;
}

.Titulo-principal{
    
    font-size: 80px;
    color: #F1EBDD;
    font-weight: normal;
    letter-spacing: 2px;
    margin: 40px auto 10px auto;
    text-align: center;
    font-family: Georgia, 'Times New Roman', Times, serif
    
}
main{
    
    margin-top: 100px; 
    margin-bottom: 150px;
}


.menu a{ 
    list-style: none;
    text-decoration: none;
    color: #2d1e18;
    letter-spacing: 1px;
    font-size: 100%;
    font-weight: 500;
}

.menu ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 25px;
}

.logo {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
}

.logo img{
     width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
}

.subtitulo{
    font-size: 17px;
    color: #F1EBDD;
    opacity: 0.9;
    font-style: italic;
    text-align: center;
    
}

html{
   scroll-behavior: smooth;
}

.seccion-menu{
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 60px;
    min-height: 100vh;
}

.texto-menu {
    max-width: 350px;
    font-size: 25px;
}

.fotos-menu {
    display: flex;
    gap: 20px;
    align-items: center;
    
}


.texto-menu a{
    color: #F1EBDD;
    text-decoration: none;
    
    
}

.seccion-local{
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 60px;
    min-height: 100vh;
}

.seccion-local a{
    text-decoration: none;
    color: #F1EBDD;
    
}
.texto-local{
    max-width: 350px;
    font-size: 25px;
    

}

.fotos-local{
     display: flex;
    gap: 20px;
    align-items: center;
}

.info-local{
    

    line-height: 40px;
    font-family: 'Georgia', 'Times New Roman', Times, serif;
    
}
.img-info{
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 50px;
    
}

.info-menu{
    display: flex;
    justify-content: center;
    align-items: flex-start; 
    gap: 50px; 
    margin-top: 8%;
}

.comida a{
    text-decoration: none;
    color: #F1EBDD;
}


.comida{
    display: flex;
    align-items: center;
    gap: 20px;
    flex-direction: column;
}

.comida h2 {
  margin: 0;
  text-align: center;
}

.reserva-logo{
    display: flex;
    margin-right: 100%;
    position: fixed;  
}

.seccion-quienes-somos{
    background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('/imagenes/foto-quienes-somos.png');
    background-size: cover;      
    background-position: center;
    width: 89.5%;
    height: 130%;
    display: flex;
    align-items: center;
    color: #F1EBDD;
    text-align: center;
    font-family: Georgia, 'Times New Roman', Times, serif;
    margin-top: 10%;
    padding: 150px 79.7px;
    scroll-margin-top: 200px;
    flex-direction: column;
}

.foto-texto-quienes-somos h2{
    font-size: 40px;
    margin: 50px;
}

.foto-texto-quienes-somos p{
    font-size: 20px;
    margin: 30px;
}

.Ubicacion{
    margin-top: 15%;
}

.seccion-contactos {
    margin-top: 15%;
    font-size: 40px;
    letter-spacing: 2px;
    text-align: center;
    border: 2px solid #F1EBDD ;
    padding: 10px 20px;
    box-shadow: 0px 4px 6px black;
    background-size: cover;      
    background-position: center;
    color: #F1EBDD;
    text-decoration: overline underline ;
    background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('/imagenes/restoran.jpg');

}
.seccion-contactos ul {
    margin-top: 10%;
    letter-spacing: 2px;
    font-size: 20px;
}

.comidas-bebidas-texto-foto{
    background-color:#f5f0e1;
    width: 70%;  /*lo que ocupa el centro*/        
    margin: 0 auto;  /*deja el verde a los lados*/
    padding: 30px;
    display: flex;
    flex-direction: column;   /* un plato debajo del otro */
    gap: 50px;
    border-radius: 7%;
}

.plato-bebida {
    display: flex;            /* imagen a la izq, texto a la der */
    align-items: center;
    gap: 30px;
}

.plato-bebida img {
    object-fit: cover;        /* que no se deforme */
    width: 250px;
    height: 250px;
    border-radius: 20%;
}

.plato-bebida h2{
    color:#1e4624;
}

.plato-bebida p{
    color:#1e4624;
}

.texto-plato-bebida {
    flex: 1;
}

.plato-bebida ul {
    list-style: none;
    color:#1e4624;
}

.volver-menu{
    width: 100%;
    margin: 30px auto;
    text-align:right;
    font-size: 30px; 
}

.volver-menu a{
    text-decoration: underline;
    color: #F1EBDD;
}

.boton-bebidas{
    width: 100%;
    text-align:right;
    font-size: 30px; 

}

.boton-bebidas a{
    text-decoration: underline;
    color: #F1EBDD;
}

.info-bebidas{
    display: flex;
    justify-content: center;
    align-items: flex-start; 
    gap: 50px; 
    margin-top: 8%;
}

.bebidas a{
    text-decoration: none;
    color: #F1EBDD;
}


.bebidas{
    display: flex;
    align-items: center;
    gap: 20px;
    flex-direction: column;
}

.bebidas h2 {
  margin: 0;
  text-align: center;
}

.volver-menu-bebidas{
    width: 100%;
    margin: 30px auto;
    text-align:right;
    font-size: 30px; 
}

.volver-menu-bebidas a{
    text-decoration: underline;
    color:#1e4624;
}

.reservas h2{
    text-align: center;
    font-size: 40px;
    margin-bottom: 20px;
}

.reservas p{
    text-align: center;
    font-size: 20px;
    margin-bottom: 40px;
}

.reservas form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 90%;
    max-width: 450px;
    background-color: #f5f0e1;
    padding: 30px;
    border-radius: 7%;
    box-shadow: 0px 4px 6px black;
    margin-bottom: 80px;
}
