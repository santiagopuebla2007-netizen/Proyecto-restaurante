body{
    background-color: #1e4624;
    color: #F1EBDD;
    font-family: 'Georgia', 'Times New Roman', Times, serif;
    margin: 0;
    width: 100%;
}

.header {
    display: flex;
    align-items: center;
    position: sticky;   
    top: 0;             
    z-index: 1000;     
    background-color: #1e4624; 
    padding: 15px 0;  
    width: 100%;
    gap: 60px;
    box-shadow: 0px 1px 2px white;
    
    
}

h1{
   font-size: 60px;
    color: #F1EBDD;
    font-weight: normal;
    letter-spacing: 2px;
    margin: 40px auto 10px auto;
    text-align: center;
    font-family: Georgia, 'Times New Roman', Times, serif
}
main{
    
    margin-top: 100px; 
    margin-bottom: 150px;
}


.menu a{ 
    list-style: none;
    text-decoration: none;
    color: #F1EBDD;
    letter-spacing: 1px;
    font-size: 13px;
    font-weight: 500;
}

.menu ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 25px;
}

.logo img{
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
}

.subtitulo{
    font-size: 14px;
    color: #F1EBDD;
    opacity: 0.9;
    font-style: italic;
    text-align: center;
    
}

html{
   scroll-behavior: smooth;
}

.seccion-menu{
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 60px;
    min-height: 100vh;
}

.texto-menu {
    max-width: 350px;
    font-size: 25px;
}

.fotos-menu {
    display: flex;
    gap: 20px;
    align-items: center;
    
}


.texto-menu a{
    color: #F1EBDD;
    text-decoration: none;
    
    
}

.seccion-local{
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 60px;
    min-height: 100vh;
}

.seccion-local a{
    text-decoration: none;
    color: #F1EBDD;
    
}
.texto-local{
    max-width: 350px;
    font-size: 25px;
    

}

.fotos-local{
     display: flex;
    gap: 20px;
    align-items: center;
}

.info-local{
    

    line-height: 40px;
    font-family: 'Georgia', 'Times New Roman', Times, serif;
    
}
.img-info{
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 50px;
    
}

