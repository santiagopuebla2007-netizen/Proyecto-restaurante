body{
    background-color: #1e4624;
    color: #F1EBDD;
    font-family: 'Georgia', 'Times New Roman', Times, serif;
    margin: 0;
    width: 100%;
}

.header {
    display: flex;
    align-items: center;
    position: sticky;   
    top: 0;             
    z-index: 1000;     
    background-color: #edd7c5; 
    padding: 15px 0;  
    width: 100%;
    gap: 60px;
    box-shadow:0px 4px 6px rgb(5,5,5);
    justify-content: center;
     min-height: 80px;
}

.Titulo-principal{
    
    font-size: 80px;
    color: #F1EBDD;
    font-weight: normal;
    letter-spacing: 2px;
    margin: 40px auto 10px auto;
    text-align: center;
    font-family: Georgia, 'Times New Roman', Times, serif
    
}
main{
    
    margin-top: 100px; 
    margin-bottom: 150px;
}


.menu a{ 
    list-style: none;
    text-decoration: none;
    color: #2d1e18;
    letter-spacing: 1px;
    font-size: 100%;
    font-weight: 500;
}

.menu ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 25px;
}

.logo {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
}

.logo img{
     width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
}

.subtitulo{
    font-size: 17px;
    color: #F1EBDD;
    opacity: 0.9;
    font-style: italic;
    text-align: center;
    
}

html{
   scroll-behavior: smooth;
}

.seccion-menu{
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 60px;
    min-height: 100vh;
}

.texto-menu {
    max-width: 350px;
    font-size: 25px;
}

.fotos-menu {
    display: flex;
    gap: 20px;
    align-items: center;
    
}


.texto-menu a{
    color: #F1EBDD;
    text-decoration: none;
    
    
}

.seccion-local{
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 60px;
    min-height: 100vh;
}

.seccion-local a{
    text-decoration: none;
    color: #F1EBDD;
    
}
.texto-local{
    max-width: 350px;
    font-size: 25px;
    

}

.fotos-local{
     display: flex;
    gap: 20px;
    align-items: center;
}

.info-local{
    

    line-height: 40px;
    font-family: 'Georgia', 'Times New Roman', Times, serif;
    
}
.img-info{
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 50px;
    
}

.info-menu{
    display: flex;
    justify-content: center;
    align-items: flex-start; 
    gap: 50px; 
    margin-top: 8%;
}

.comida a{
    text-decoration: none;
    color: #F1EBDD;
}


.comida{
    display: flex;
    align-items: center;
    gap: 20px;
    flex-direction: column;
}

.comida h2 {
  margin: 0;
  text-align: center;
}

.reserva-logo{
    display: flex;
    margin-right: 100%;
    position: fixed;  
}

.seccion-quienes-somos{
    background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('imagenes/foto-quienes-somos.png');
    background-size: cover;      
    background-position: center;
    width: 89.5%;
    height: 130%;
    display: flex;
    align-items: center;
    color: #F1EBDD;
    text-align: center;
    font-family: Georgia, 'Times New Roman', Times, serif;
    margin-top: 10%;
    padding: 150px 79.7px;
    scroll-margin-top: 200px;
    flex-direction: column;
}

.foto-texto-quienes-somos h2{
    font-size: 40px;
    margin: 50px;
}

.foto-texto-quienes-somos p{
    font-size: 20px;
    margin: 30px;
}

.Ubicacion{
    margin-top: 15%;
}

.seccion-contactos {
    margin-top: 15%;
    font-size: 40px;
    letter-spacing: 2px;
    text-align: center;
    border: 2px solid #F1EBDD ;
    padding: 10px 20px;
    box-shadow: 0px 4px 6px black;
    background-size: cover;      
    background-position: center;
    color: #F1EBDD;
    text-decoration: overline underline ;
    background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('imagenes/restoran.jpg');

}
.seccion-contactos ul {
    margin-top: 10%;
    letter-spacing: 2px;
    font-size: 20px;
}

.comidas-bebidas-texto-foto{
    background-color:#f5f0e1;
    width: 70%;  /*lo que ocupa el centro*/        
    margin: 0 auto;  /*deja el verde a los lados*/
    padding: 30px;
    display: flex;
    flex-direction: column;   /* un plato debajo del otro */
    gap: 50px;
    border-radius: 7%;
}

.plato-bebida {
    display: flex;            /* imagen a la izq, texto a la der */
    align-items: center;
    gap: 30px;
}

.plato-bebida img {
    object-fit: cover;        /* que no se deforme */
    width: 250px;
    height: 250px;
    border-radius: 20%;
}

.plato-bebida h2{
    color:#1e4624;
}

.plato-bebida p{
    color:#1e4624;
}

.texto-plato-bebida {
    flex: 1;
}

.plato-bebida ul {
    list-style: none;
    color:#1e4624;
}

.volver-menu{
    width: 100%;
    margin: 30px auto;
    text-align:right;
    font-size: 30px; 
}

.volver-menu a{
    text-decoration: underline;
    color: #F1EBDD;
}

.boton-bebidas{
    width: 100%;
    text-align:right;
    font-size: 30px; 

}

.boton-bebidas a{
    text-decoration: underline;
    color: #F1EBDD;
}

.info-bebidas{
    display: flex;
    justify-content: center;
    align-items: flex-start; 
    gap: 50px; 
    margin-top: 8%;
}

.bebidas a{
    text-decoration: none;
    color: #F1EBDD;
}


.bebidas{
    display: flex;
    align-items: center;
    gap: 20px;
    flex-direction: column;
}

.bebidas h2 {
  margin: 0;
  text-align: center;
}

.volver-menu-bebidas{
    width: 100%;
    margin: 30px auto;
    text-align:right;
    font-size: 30px; 
}

.volver-menu-bebidas a{
    text-decoration: underline;
    color:#1e4624;
}

.titulo-reserva{
    text-align: center;
    font-size: 40px;
    margin-bottom: 20px;
}

.subtitulo-reserva{
    text-align: center;
    font-size: 20px;
    margin-bottom: 40px;
}

.pagina-login{
    background-color: #1f3722;
}

.pagina-login main{
   margin: 0;
}

.login {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    padding: 20px;
}

.login form{
    background-color: #1e4624;
    display: flex;
    flex-direction: column;
    gap: 15px;
    align-items: center;
    padding: 40px;
    border-radius: 5%;
    margin: 0%;
    box-shadow: 0px 4px 6px black;
    max-width: 420px;
    min-height: 600px; 
}

.login h2{
    text-align: center;
    color: #F1EBDD;
    font-family: 'Times New Roman', Times, serif;
    font-size: 30px;
    margin: 0%;
}

.login p{
    text-align: center;
    color: #F1EBDD;
    font-family: 'Times New Roman', Times, serif;
    font-size: 20px;
    margin: 20px;
}

.login input{
    background-color: #1e4624;
    color: #F1EBDD;
    font-size: 15px;
    font-family: 'Times New Roman', Times, serif;
    border-radius: 8%;
    padding: 12px;
    margin: 10px;
    width: 300px;
}

.login button{
      background-color: #edd7c5;
    color: #1e4624;
    border: none;
    padding: 10px;
    font-size: 16px;
    cursor: pointer;
    border-radius: 5%;
    border: none;
    margin: 40px;
    width: 300px;
}

.login-logo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 10px;
}

.volver-inicio{
    width: 300%;
      max-width: 1000px;     
    margin: 20px auto; 
    margin: 0;
    text-align:right;
    font-size: 20px; 
} 

.volver-inicio a{
    text-decoration: none;
    color: #F1EBDD;
}

.titulo-tabla{
    text-align: center;
    color: #F1EBDD;
    font-size: 30px;
    font-family: 'Times New Roman', Times, serif;
    margin: 0 0 0px 0;
    justify-content: center;
}

.subtitulo-tabla{
        text-align: center;
    color: #F1EBDD;
    font-size: 20px;
    font-family: 'Times New Roman', Times, serif;
    margin: 0;
    justify-content: center;
} 

.tabla-reserva {
    max-width: 900px;
    margin: 30px auto;
    background-color:#1e4624;
    border-radius: 10%;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
    overflow-x: auto;
    padding: 4%;
}
.tabla-reserva th,
.tabla-reserva td {
    background-color: #24502b;
    color:#F1EBDD;
    padding: 12px;
    text-align: center;
    border-radius: 10%;
}

.tabla-reserva table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 6px;
}

.pagina-tabla{
        background-color: #1f3722;
}


.eliminar{
    border-radius: 10%;
    text-align: center;
    background-color: #3a1704;
    color: #F1EBDD;
    font-family:Arial, Helvetica, sans-serif;
    cursor: pointer;
    font-size: 15px;
}

@media (max-width: 768px) {

    img {
        max-width: 100%;
        height: auto;
    }

    .header {
        position: static;
        flex-direction: column;
        gap: 10px;
        padding: 10px 0;
    }

    .logo {
        position: static;
        transform: none;
    }

    .menu ul {
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px 15px;
        padding: 0 10px;
    }

    .menu a {
        font-size: 14px;
    }



    .Titulo-principal {
        font-size: 40px;
    }

    main {
        margin-top: 40px;
        margin-bottom: 80px;
    }

    .subtitulo {
        font-size: 15px;
        padding: 0 15px;
    }

    .seccion-menu,
    .seccion-local {
        flex-direction: column;
        gap: 30px;
        min-height: auto;
        padding: 40px 15px;
        text-align: center;
    }

    .texto-menu,
    .texto-local {
        max-width: 100%;
        font-size: 20px;
    }

    .foto-menu,
    .fotos-local {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .foto-menu img,
    .fotos-local img {
        width: 100%;
        max-width: 300px;
        height: auto;
    }

        .seccion-quienes-somos {
        width: auto;
        height: auto;
        padding: 60px 20px;
        margin-top: 60px;
    }

    .foto-texto-quienes-somos h2 {
        font-size: 28px;
        margin: 20px 0;
    }

    .foto-texto-quienes-somos p {
        font-size: 16px;
        margin: 15px 0;
    }

    .seccion-contactos {
        font-size: 24px;
        margin-top: 60px;
    }

    .seccion-contactos h1 {
        font-size: 28px;
    }

    .seccion-contactos ul {
        margin-top: 30px;
        padding: 0;
        font-size: 16px;
    }

    .Ubicacion {
        margin-top: 60px;
    }

    .reserva-logo {
        margin-right: 0;
        left: 10px;
        bottom: 10px;
        z-index: 900;
    }

    .reserva-logo img {
        width: 80px;
        height: 80px;
    }

        .info-menu,
    .info-bebidas {
        flex-direction: column;
        align-items: center;
        gap: 30px;
        margin-top: 30px;
    }

    .comidas-bebidas-texto-foto {
        width: 85%;
        padding: 20px 15px;
        gap: 30px;
    }

    .plato-bebida {
        flex-direction: column;
        text-align: center;
        gap: 15px;
    }

    .plato-bebida img {
        width: 100%;
        max-width: 300px;
        height: 250px;
    }

    .plato-bebida ul {
        padding: 0;
    }

    .volver-menu,
    .volver-menu-bebidas,
    .boton-bebidas {
        font-size: 20px;
        text-align: center;
    }

    .img-info {
        flex-direction: column;
        gap: 20px;
        padding: 0 15px;
    }

    .foto-info img {
        width: 100%;
        height: auto;
    }

    .info-local {
        line-height: 28px;
    }

    .info-local br {
        display: none;
    }

        .login main {
        width: 100%;
    }

    .login form {
        box-sizing: border-box;
        width: 100%;
        padding: 25px 15px;
        min-height: auto;
    }

    .login input,
    .login button {
        box-sizing: border-box;
        width: 100%;
        margin: 8px 0;
    }

    .login button {
        margin: 20px 0;
    }

    .volver-inicio {
        width: 100%;
        text-align: center;
    }

    .titulo-tabla {
        font-size: 24px;
    }

    .subtitulo-tabla {
        font-size: 16px;
        padding: 0 15px;
    }

    .tabla-reserva {
        margin: 20px 10px;
        padding: 10px;
    }

    .tabla-reserva th,
    .tabla-reserva td {
        padding: 6px;
        font-size: 13px;
    }

}
