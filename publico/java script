document.addEventListener("DOMContentLoaded", () => {
  const BRILLO = "rgba(241, 235, 221, 0.95)"; // color del resplandor
  const links = [...document.querySelectorAll('.menu a')];
  let activo = null;

  const aplicar = (a, hover) => {
    const esActivo = a === activo;
    a.style.transform = hover ? "scale(1.18)" : esActivo ? "scale(1.08)" : "scale(1)";
    a.style.textShadow = hover
      ? `0 0 10px ${BRILLO}, 0 0 22px ${BRILLO}`
      : esActivo
      ? `0 0 8px ${BRILLO}`
      : "none";
  };


//menu que se agranda al pasar el mouse 

  links.forEach((a) => {
    a.style.display = "inline-block";
    a.style.transition = "transform 0.25s ease, text-shadow 0.25s ease";
    a.addEventListener("mouseenter", () => aplicar(a, true));
    a.addEventListener("mouseleave", () => aplicar(a, false));
  });

  // Detecta la sección visible y marca su link
  const anclas = links.filter((a) => a.getAttribute("href").startsWith("#"));
  const observer = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((en) => {
        if (en.isIntersecting) {
          activo = anclas.find((a) => a.getAttribute("href") === "#" + en.target.id) || null;
          links.forEach((a) => aplicar(a, false));
        }
      });
    },
    { rootMargin: "-10% 0px -60% 0px" }
  );

  anclas.forEach((a) => {
    const seccion = document.querySelector(a.getAttribute("href"));
    if (seccion) observer.observe(seccion);
  });
});

//Desvanesimiento del titulo

document.addEventListener("DOMContentLoaded", () => {
  const titulo = document.querySelector(".Titulo-principal");
  const subtitulo = document.querySelector(".subtitulo");
  if (!titulo) return;

  window.addEventListener("scroll", () => {
    const y = window.scrollY;
    if (y > 700) return;
    titulo.style.transform = `translateY(${y * 0.3}px)`;
    titulo.style.opacity = Math.max(0, 1 - y / 500);
    if (subtitulo) subtitulo.style.opacity = Math.max(0, 1 - y / 400);
  });
});

//Boton de reservas que late

document.addEventListener("DOMContentLoaded", () => {
  const imagen = document.querySelector(".reserva-logo img");
  if (!imagen) return;

  const pulso = imagen.animate(
    [
      { boxShadow: "0 0 0 0 rgba(241, 235, 221, 0.8)" },
      { boxShadow: "0 0 0 28px rgba(241, 235, 221, 0)" },
    ],
    { duration: 1800, iterations: Infinity, easing: "ease-out" }
  );

  imagen.style.transition = "transform 0.3s ease";
  imagen.addEventListener("mouseenter", () => {
    pulso.pause();
    imagen.style.transform = "scale(1.1)";
  });
  imagen.addEventListener("mouseleave", () => {
    pulso.play();
    imagen.style.transform = "scale(1)";
  });
});

//secciones que aparecen poco a poco
document.addEventListener("DOMContentLoaded", () => {
  const secciones = document.querySelectorAll("section");

  secciones.forEach((s) => {
    s.style.opacity = "0";
    s.style.transform = "translateY(50px)";
    s.style.transition = "opacity 0.9s ease, transform 0.9s ease";
  });

  const observer = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((en) => {
        if (en.isIntersecting) {
          en.target.style.opacity = "1";
          en.target.style.transform = "translateY(0)";
          observer.unobserve(en.target); 
        }
      });
    },
    { threshold: 0.12 }
  );

  secciones.forEach((s) => observer.observe(s));
});
