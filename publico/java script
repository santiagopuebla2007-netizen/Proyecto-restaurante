document.addEventListener("DOMContentLoaded", () => {

  /* ---------- 1. Scroll suave en las anclas ---------- */
  const ALTO_MENU_FIJO = 0; // si tu header queda fijo arriba, poné su alto en px (ej. 120)

  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener("click", (e) => {
      const id = link.getAttribute("href");
      if (id.length < 2) return;
      const destino = document.querySelector(id);
      if (!destino) return;
      e.preventDefault();
      const y = destino.getBoundingClientRect().top + window.scrollY - ALTO_MENU_FIJO;
      window.scrollTo({ top: y, behavior: "smooth" });
      history.pushState(null, "", id);
    });
  });

  /* ---------- 2. Resaltar en el menú la sección visible ---------- */
  const navLinks = [...document.querySelectorAll('.menu a[href^="#"]')];
  const secciones = navLinks
    .map((a) => document.querySelector(a.getAttribute("href")))
    .filter(Boolean);

  if (secciones.length) {
    const observer = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((en) => {
          if (en.isIntersecting) {
            navLinks.forEach((a) =>
              a.classList.toggle("activo", a.getAttribute("href") === "#" + en.target.id)
            );

          }
        });
      },
      { rootMargin: `-${ALTO_MENU_FIJO + 10}px 0px -60% 0px` }
    );
    secciones.forEach((s) => observer.observe(s));
  }

  /* ---------- 3. Botón "volver arriba" ---------- */
  const btnTop = document.createElement("button");
  btnTop.textContent = "↑";
  btnTop.setAttribute("aria-label", "Volver arriba");
  btnTop.style.cssText =
    "position:fixed;right:20px;bottom:20px;width:46px;height:46px;border:none;" +
    "border-radius:50%;background:#F1EBDD;color:#222;font-size:22px;cursor:pointer;" +
    "box-shadow:0 4px 12px rgba(0,0,0,.3);opacity:0;pointer-events:none;" +
    "transition:opacity .3s;z-index:900;";
  document.body.appendChild(btnTop);

  window.addEventListener("scroll", () => {
    const visible = window.scrollY > 400;
    btnTop.style.opacity = visible ? "1" : "0";
    btnTop.style.pointerEvents = visible ? "auto" : "none";
  });
  btnTop.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

  /* ---------- 4. Ampliar fotos al hacer clic ---------- */
  document.querySelectorAll(".foto-menu img, .fotos-local img").forEach((img) => {
    img.loading = "lazy";
    img.style.cursor = "zoom-in";
    img.addEventListener("click", () => abrirLightbox(img.currentSrc || img.src, img.alt));
  });
  
  function abrirLightbox(src, alt) {
    const fondo = document.createElement("div");
    fondo.style.cssText =
      "position:fixed;inset:0;background:rgba(0,0,0,.88);display:flex;flex-direction:column;" +
      "align-items:center;justify-content:center;z-index:2000;cursor:zoom-out;padding:20px;";

    const grande = document.createElement("img");
    grande.src = src;
    grande.alt = alt || "";
    grande.style.cssText = "max-width:95%;max-height:80vh;border-radius:8px;";
    fondo.appendChild(grande);

    if (alt) {
      const pie = document.createElement("p");
      pie.textContent = alt;
      pie.style.cssText = "color:#fff;margin-top:12px;font-size:1.1rem;text-align:center;";
      fondo.appendChild(pie);
    }

    const cerrar = () => {
      fondo.remove();
      document.removeEventListener("keydown", alEscape);
    };
    const alEscape = (e) => e.key === "Escape" && cerrar();

    fondo.addEventListener("click", cerrar);
    document.addEventListener("keydown", alEscape);
    document.body.appendChild(fondo);
  }
});

//Se escribe letra por letra el titulo al cargar la pagina

document.addEventListener("DOMContentLoaded", () => {
  const subtitulo = document.querySelector(".subtitulo");
  if (!subtitulo) return;

  const texto = subtitulo.textContent.trim();
  const VELOCIDAD = 60; 
  subtitulo.textContent = "";

  let i = 0;
  const escribir = () => {
    subtitulo.textContent = texto.slice(0, i) + (i < texto.length ? "▌" : "");
    if (i < texto.length) {
      i++;
      setTimeout(escribir, VELOCIDAD);
    }
  };
  setTimeout(escribir, 500);
});

